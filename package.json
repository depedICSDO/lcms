{
  "name": "leave-credits-system",
  "version": "1.0.0",
  "description": "Personnel leave credits management system",
  "type": "module",
  "main": "src/main/main.js",
  "author": "BuzzJay <jaybhee84>",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "test": "node --test",
    "electron": "electron .",
    "dist": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.21",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.leavecreditssystem.app",
    "productName": "Leave Credits System",
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "jaybhee84",
      "repo": "leave-credits-system"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    }
  }
}
